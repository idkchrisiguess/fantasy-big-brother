# Copy to .env.local and fill from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# After running supabase/schema.sql, enable Realtime on `public.leagues`
# (Supabase Dashboard → Database → Replication → supabase_realtime → leagues)
